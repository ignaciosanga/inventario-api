{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "clave-super-secreta-para-el-examen-api-gateway-2026",
    "Issuer": "inventario-gateway",
    "Audience": "inventario-clientes",
    "ExpiresMinutes": 60
  },
  "Auth": {
    "Usuario": "admin",
    "Clave": "admin123"
  },
  "Cors": {
    "Origenes": [ "http://localhost:3000", "http://localhost:5173", "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "inventario",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "swagger": {
        "ClusterId": "inventario",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "servicio-health": {
        "ClusterId": "inventario",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/servicio/health" },
        "Transforms": [ { "PathRemovePrefix": "/servicio" } ]
      },
      "servicio-health-db": {
        "ClusterId": "inventario",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/servicio/health/db" },
        "Transforms": [ { "PathRemovePrefix": "/servicio" } ]
      }
    },
    "Clusters": {
      "inventario": {
        "Destinations": {
          "principal": { "Address": "http://localhost:5204/" }
        }
      }
    }
  }
}
