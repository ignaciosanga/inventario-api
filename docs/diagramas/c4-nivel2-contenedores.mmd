        gateway["<b>API Gateway</b><br/>[ASP.NET Core 8 + YARP]<br/>Único punto de entrada :5000<br/>CORS · Logging · JWT"]
        servicio["<b>Microservicio Inventario</b><br/>[ASP.NET Core 8 Web API]<br/>CRUD · Repository · DTO · DI<br/>Swagger · Health"]
        db[("<b>Base de datos</b><br/>[PostgreSQL 16]<br/>Categorias · Productos · Movimientos")]
